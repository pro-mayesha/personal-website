# Copy to `.env.local` for Next.js (never commit real secrets).

# MongoDB (server-side only — safe on Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/personal-blogs?retryWrites=true&w=majority
MONGODB_DB_NAME=personal-blogs

# Admin JWT for /api/auth (min 16 characters)
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# Local admin login when MongoDB Atlas is down or the cluster was deleted
ADMIN_ID=proma
ADMIN_PASSWORD=replace-with-at-least-8-characters
